{
  "name": "winery-kit",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:watch": "pnpm -r --parallel build:watch",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "check": "biome check ./packages",
    "docs:check": "node scripts/check-docs.mjs",
    "format": "biome format --write ./packages",
    "release:set-version": "node scripts/set-version.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:pack": "node scripts/release-pack.mjs",
    "release:publish": "node scripts/release-publish.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16"
  }
}
